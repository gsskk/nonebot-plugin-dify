# .env.example
# This is an example configuration file for the nonebot-plugin-dify.
# Copy this file to .env and fill in the required values.

# --- Core Configuration ---
# DIFY API URL, supports self-hosting
DIFY_API_BASE=https://api.dify.ai/v1
# DIFY Main App API Key (Required)
DIFY_MAIN_APP_API_KEY=app-your-main-app-api-key
# DIFY App Type: chatbot/chatflow, agent, workflow
DIFY_MAIN_APP_TYPE=chatbot
# DIFY API request timeout in seconds
DIFY_TIMEOUT_IN_SECONDS=90

# --- Session Management ---
# Maximum number of messages in a session before it's cleared
SESSION_MAX_MESSAGES=20
# Session expiration time in seconds
SESSION_EXPIRES_SECONDS=3600
# Whether to share the same session in a group chat. Note: this has no effect if group chat recording is enabled.
SESSION_SHARE_IN_GROUP=False

# --- Message Processing ---
# Prefixes to ignore, messages starting with these will not trigger a reply
IGNORE_PREFIX='["/", "."]'
# Maximum length of a single chat message to be recorded
MESSAGE_MAX_LENGTH=200
# Whether to enable message desensitization
MESSAGE_DESENSITIZATION_ENABLE=True

# --- Image Upload ---
# Whether to enable image uploading. Requires LLM model to support image recognition and nonebot_plugin_alconna to support the adapter.
IMAGE_UPLOAD_ENABLE=False
# Subdirectory for image cache
IMAGE_CACHE_DIR="image"

# --- Image History Context ---
# How to handle images in chat history:
# - placeholder: mark [image] in history (default, recommended)
# - description: generate and store image descriptions (requires IMAGE_DESCRIPTION_WORKFLOW_API_KEY)
#   ⚠️ WARNING: "description" mode calls the workflow for EVERY image received, consuming significant tokens!
# - none: ignore images in history
HISTORY_IMAGE_MODE=placeholder
# Dify Workflow API Key for generating image descriptions (only for description mode)
IMAGE_DESCRIPTION_WORKFLOW_API_KEY=
# Image reference cache TTL in seconds (default 30 minutes)
IMAGE_REFERENCE_CACHE_TTL=1800
# How to trigger cached image attachment (non-off values enable image caching):
# - off: don't cache, don't auto-attach (default)
# - keyword: cache images, attach when message contains image-related keywords
# - semantic: cache images, attach based on semantic matching (auto-fallback to keyword if unavailable)
# - always: cache images, always attach if cached image exists
IMAGE_ATTACH_MODE=off

# --- Group Chat Settings ---
# Number of recent messages to fetch for personalized replies in group chats
GROUP_CHAT_HISTORY_LIMIT=10
# Maximum length of recent messages to fetch for personalized replies in group chats
GROUP_CHAT_HISTORY_SIZE=1024

# --- User Profiling (Group) ---
# Dify Workflow API Key for generating group profiles
PROFILER_WORKFLOW_API_KEY=
# Cron schedule for the group profiling task
PROFILER_SCHEDULE="0 3 * * *"
# Jitter in minutes to spread out the task execution after the scheduled time. 0 to disable.
PROFILER_SCHEDULE_JITTER=10
# Number of recent history messages to analyze for profiling
PROFILER_HISTORY_LIMIT=50
# Minimum number of valid messages required for profiling
PROFILER_MIN_MESSAGES=10
# Maximum length of chat history allowed for profiling
PROFILER_CHAT_HISTORY_SIZE=1024

# --- Personalization ---
# Default personalization description to apply when a group enables profiling for the first time
DEFAULT_PERSONALIZATION="你叫喵喵，是一位有点傲娇的猫娘，说话时偶尔在句末加'喵~'，但只在心情好时才会这样。你说话简洁直接，不过偶尔会露出一丝可爱。请保持回答简短，不做多余描写，不添加动作或旁白。"

# --- Private Chat Settings ---
# Whether to enable private chat personalization
PRIVATE_PERSONALIZATION_ENABLE=False
# Number of recent messages to fetch for personalized replies in private chats
PRIVATE_CHAT_HISTORY_LIMIT=20
# Maximum length of recent messages to fetch for personalized replies in private chats
PRIVATE_CHAT_HISTORY_SIZE=2048
# Minimum number of valid messages required for private chat profiling
PRIVATE_PROFILER_MIN_MESSAGES=15
# Cron schedule for the private chat profiling task
PRIVATE_PROFILER_SCHEDULE="0 4 * * *"
# Jitter in minutes to spread out the task execution after the scheduled time. 0 to disable.
PRIVATE_PROFILER_SCHEDULE_JITTER=10
# Number of days to retain private user data before automatic cleanup
PRIVATE_DATA_RETENTION_DAYS=90

# --- API Optimization ---
# Maximum number of retries for API calls
API_MAX_RETRIES=3
# Base delay in seconds for API retries
API_RETRY_BASE_DELAY=1.0
# Maximum delay in seconds for API retries
API_RETRY_MAX_DELAY=30.0
# Failure threshold for the API circuit breaker
API_CIRCUIT_BREAKER_THRESHOLD=5
# Timeout in seconds for the API circuit breaker
API_CIRCUIT_BREAKER_TIMEOUT=300
# Batch size for batch API calls
API_BATCH_SIZE=5
# Delay in seconds between batches
API_BATCH_DELAY=2.0

# --- System Monitoring ---
# The full, cross-platform user ID of the administrator who will receive critical system alerts.
# Get this ID by sending the /get_my_id command to the bot in a private chat.
# Example: SYSTEM_ADMIN_USER_ID=onebot+private+123456789
SYSTEM_ADMIN_USER_ID=
